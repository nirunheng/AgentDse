# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
key.json
*.key
*.pem
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
build/
dist/
*.egg-info/

# ---------------------------------------------------------------------------
# Experiment outputs — regenerated by tests/, never hand-edited
# ---------------------------------------------------------------------------
# ATLAS per-run artifacts (~2.9 MB each, 2700+ files: core_*.yaml dumps).
# data/artifacts/<tag>/metrics.json is the only file worth keeping, and it is
# already summarised into logs/report_table.txt and data/seed/*.json.
data/artifacts/

# ad-hoc smoke test scratch space
data/_smoketest/

# generated DRAM yaml, rebuilt by dramcfg.write_cfg() on every run
data/dram_cfgs/

# sqlite trial databases: local experiment state, not source
*.db
*.db-journal
*.sqlite

# run logs, traces, plots
logs/
